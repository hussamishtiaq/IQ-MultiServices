# ── Supabase ────────────────────────────────────────────────
# Get from your Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Cloudinary ──────────────────────────────────────────────
# Get from cloudinary.com → Dashboard. Create an UNSIGNED upload preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ── Resend (email notifications on new lead) ────────────────
# Free tier: 3000 emails/mo. Sign up at resend.com → API Keys.
# Leave RESEND_API_KEY empty to disable emails (e.g. in dev).
RESEND_API_KEY=
LEAD_EMAIL_TO=your-admin-email@example.com
LEAD_EMAIL_FROM=IQ MultiServices <onboarding@resend.dev>

# ── Site ────────────────────────────────────────────────────
# Used for absolute URLs (sitemap, OG tags, lead notification links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase service role (server-only) ─────────────────────
# Needed for lead automation, webhooks, unsubscribe and the message dispatcher.
# Settings → API → service_role. Never expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# ── Brokerage details (footer + listing pages) ──────────────
NEXT_PUBLIC_COMPANY_ORN=
NEXT_PUBLIC_TRADE_LICENSE=
# Business WhatsApp number for "Ask on WhatsApp" buttons (digits incl. country code, e.g. 971501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Messaging (bulk email + WhatsApp) ───────────────────────
# Keep DRY_RUN=true until WhatsApp/email are fully set up: sends are simulated and only logged.
MESSAGING_DRY_RUN=true
MARKETING_EMAIL_FROM=
MARKETING_EMAIL_REPLY_TO=
MARKETING_UNSUBSCRIBE_MAILTO=
RESEND_WEBHOOK_SECRET=
EMAIL_MAX_DAILY=2000
EMAIL_BATCH_SIZE=50
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DAILY_CAP=250
WHATSAPP_BATCH_SIZE=20
WHATSAPP_GRAPH_VERSION=v23.0
# Optional approved utility templates (acks, viewing confirmations/reminders, listing alerts)
WHATSAPP_ACK_TEMPLATE=
WHATSAPP_VIEWING_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
MESSAGING_SEND_START_HOUR=9
MESSAGING_SEND_END_HOUR=18
MESSAGING_TIMEZONE=Asia/Dubai
# Auth for an external scheduler calling GET /api/messaging/dispatch (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
